# Plantilla de configuración de variables de entorno

# Tu API Key de OpenAI para llamadas al LLM y embeddings en la nube
OPENAI_API_KEY=your_openai_api_key_here

# Proveedor de embeddings a utilizar: 'openai' (nube) o 'local' (en tu máquina)
EMBEDDING_PROVIDER=openai

# Modelos para embeddings en la nube (OpenAI)
EMBEDDING_MODEL=text-embedding-3-small

# Modelo para embeddings en local (se descarga automáticamente de Hugging Face)
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Proveedor de LLM a utilizar: 'openai' (nube) o 'local' (Ollama)
LLM_PROVIDER=openai

# Modelo de lenguaje en la nube (OpenAI)
LLM_MODEL=gpt-4o-mini

# Modelo de lenguaje local (requiere instalar Ollama y tener el modelo descargado)
LOCAL_LLM_MODEL=phi3
